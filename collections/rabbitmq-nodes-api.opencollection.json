{
  "opencollection": "1.0.0",
  "info": {
    "name": "RabbitMQ Management HTTP Bindings Nodes API",
    "version": "3.13.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nodes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List nodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:15672/api/nodes"
          },
          "docs": "List nodes"
        },
        {
          "info": {
            "name": "Get node details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://localhost:15672/api/nodes/:name",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get node details"
        }
      ]
    }
  ],
  "bundled": true
}